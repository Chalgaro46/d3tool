 "model": {
  "_doc": "상대 비교용 모델. 상수 배율(세트 6종, 카를레이, 전설 보석 등)은 모든 후보에 공통이라 생략. 공격력·강인함은 '기준 대비 배율'만 의미 있음.",
  "level": 70,
  "squirt": {
   "max": 1.0,
   "pylonMin": 2,
